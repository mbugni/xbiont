ARG X_IMAGE_PLATFORM="x86_64"

FROM docker.io/i386/debian:bookworm-slim AS bookworm-i686

FROM docker.io/debian:bookworm-slim AS bookworm-x86_64

FROM bookworm-${X_IMAGE_PLATFORM} AS deb12-${X_IMAGE_PLATFORM}
COPY entrypoint.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
RUN chmod +x /usr/local/bin/entrypoint.sh && \
apt-get update && \
apt-get --assume-yes upgrade && \
apt-get --assume-yes install \
        systemd \
        bash-completion \
        sudo \
        dosfstools \
        e2fsprogs \
        mtools \
        squashfs-tools \
        qemu-utils \
        rsync \
        xorriso \
        grub-pc-bin \
        python3-pip && \
pip3 install --break-system-packages --exists-action=i kiwi==10.3.* && \
pip3 cache purge && \
apt-get autoclean

FROM deb12-${X_IMAGE_PLATFORM} AS deb11-${X_IMAGE_PLATFORM}

FROM deb12-${X_IMAGE_PLATFORM} AS deb13-${X_IMAGE_PLATFORM}
