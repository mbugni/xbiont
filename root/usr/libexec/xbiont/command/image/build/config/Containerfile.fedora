FROM registry.fedoraproject.org/fedora-minimal:43 AS fc43-x86_64
COPY entrypoint.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
RUN chmod +x /usr/local/bin/entrypoint.sh && \
microdnf --assumeyes --setopt='tsflags=nodocs' --setopt='install_weak_deps=False' install \
        systemd \
        bash-completion \
        distribution-gpg-keys \
        python3-pip \
        kiwi-systemdeps-iso-media && \
pip3 install --exists-action=i --break-system-packages kiwi==10.3.* && \
pip3 cache purge && \
microdnf --assumeyes clean all && \
rm /etc/rpm/* -rf

FROM fc43-x86_64 AS fc44-x86_64
