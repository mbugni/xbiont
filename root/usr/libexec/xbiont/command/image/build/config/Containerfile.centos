FROM quay.io/centos/centos:stream10-minimal AS c10s-x86_64
COPY entrypoint.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
RUN chmod +x /usr/local/bin/entrypoint.sh && \
microdnf --assumeyes install epel-release && \
microdnf --assumeyes --setopt='tsflags=nodocs' --setopt='install_weak_deps=0' install \
        systemd \
        bash-completion \
        distribution-gpg-keys \
        python3-pip \
        kiwi-systemdeps-iso-media && \
pip3 install --exists-action=i --break-system-packages kiwi==10.3.* && \
pip3 cache purge && \
microdnf --assumeyes clean all && \
rm /etc/rpm/* -rf
