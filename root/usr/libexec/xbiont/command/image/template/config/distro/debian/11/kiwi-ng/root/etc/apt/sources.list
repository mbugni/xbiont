deb https://deb.debian.org/debian ${X_DISTRO_CODENAME} main contrib non-free
#deb-src https://deb.debian.org/debian ${X_DISTRO_CODENAME} main contrib non-free

deb https://deb.debian.org/debian ${X_DISTRO_CODENAME}-updates main contrib non-free
#deb-src https://deb.debian.org/debian ${X_DISTRO_CODENAME}-updates main contrib non-free

deb https://security.debian.org/debian-security/ ${X_DISTRO_CODENAME}-security main contrib non-free
#deb-src https://security.debian.org/debian-security/ ${X_DISTRO_CODENAME}-security main contrib non-free