FROM registry.fedoraproject.org/fedora-minimal:${X_DISTRO_VERSION}

COPY entrypoint.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

RUN chmod +x /usr/local/bin/entrypoint.sh && \
microdnf --assumeyes --setopt='tsflags=nodocs' --setopt='install_weak_deps=False' install \
        systemd \
        bash-completion \
        distribution-gpg-keys \
        python3-pip \
        kiwi-systemdeps-iso-media && \
pip3 install --exists-action=i --break-system-packages kiwi==10.2.* && \
pip3 cache purge && \
microdnf --assumeyes clean all && \
rm /etc/rpm/* -rf
