[Unit]
Description=System wide setup
Before=getty@tty1.service
Before=display-manager.service

[Service]
Type=oneshot
Restart=no
RemainAfterExit=no
ExecStart=/usr/bin/xbiont system setup

[Install]
WantedBy=multi-user.target
