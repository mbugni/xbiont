#!/usr/bin/bash
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (c) 2026 Massimiliano Bugni
#
# xbiont: service request executor

invoked_program="${BASH_SOURCE[0]##*/}"
invoked_service="$1"
invoked_request="$2"

if [[ $# -lt 2 ]]; then 
    exec echo "Usage: ${invoked_program} service request"
fi

if [[ $# -gt 2 ]]; then
    # Parse additional variables passed as VAR_NAME=VAR_VALUE
    shift 2
    while [[ $# -gt 0 ]]; do
        invoked_var_name="${1%%=*}"
        invoked_var_value="${1#*=}"
        export "$invoked_var_name=$invoked_var_value"
        shift
    done
fi

# The commands root paths
export X_PULSE_DIR="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" &> /dev/null && pwd)"
export X_CORE_DIR=$(readlink -f "${X_PULSE_DIR}/../libexec/${invoked_program}")
if [ "$invoked_service" == "run" ]; then
    export X_ACTIONABLE_DIR="${X_CORE_DIR}/tool/$invoked_request"
else
    export X_ACTIONABLE_DIR="${X_CORE_DIR}/command/$invoked_service/$invoked_request"
fi

source ${X_CORE_DIR}/module/variables.sh
source ${X_CORE_DIR}/module/functions.sh

invoked_action='action@run.sh'
if [ ! -x "$X_ACTIONABLE_DIR/$invoked_action" ]; then
    x::log_error "Fatal: action not implemented '$invoked_service $invoked_request'"
    exit 1
fi

x::export_with_value 'X_ACTIONABLE_SERVICE' "$invoked_service"
x::export_with_value 'X_ACTIONABLE_REQUEST' "$invoked_request"
x::export_with_default 'X_ACTIONABLE_LOG_MODE' 'file'

case "$X_ACTIONABLE_LOG_MODE" in
    passthrough)
        x::execute_activations "$invoked_action"
        exit $?
        ;;
    file|split) ;;
    *)
        echo "Invalid X_ACTIONABLE_LOG_MODE: $X_ACTIONABLE_LOG_MODE" >&2
        exit 1
        ;;
esac

export X_ACTIONABLE_LOG_DIR="/var/log/${invoked_program}"

# Ensure log directory exists
if [ ! -d "$X_ACTIONABLE_LOG_DIR" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        X_ACTIONABLE_LOG_DIR="/tmp/${invoked_program}"
    fi
    mkdir --parents $X_ACTIONABLE_LOG_DIR
    chmod ugo+rwx $X_ACTIONABLE_LOG_DIR
fi

actionable_log_file="${X_ACTIONABLE_LOG_DIR}/${invoked_service}-${invoked_request}.log"

# 'file' merges diagnostics into the log; 'split' keeps stderr untouched so
# structured output on stdout stays consumable (e.g. by frontend processes)
if [ "$X_ACTIONABLE_LOG_MODE" = "split" ]; then
    x::execute_activations "$invoked_action" | tee "$actionable_log_file"
else
    x::execute_activations "$invoked_action" 2>&1 | tee "$actionable_log_file"
fi
exit "${PIPESTATUS[0]}"
