#
# xbiont: service command executor

invoked_program="${BASH_SOURCE[0]##*/}"
invoked_service="$1"
invoked_command="$2"

if [[ $# -lt 2 ]]; then 
    exec echo "Usage: ${invoked_program} service command"
fi

if [[ $# -gt 2 ]]; then
    # Parse additional variables passed as VAR_NAME=VAR_VALUE
    shift 2
    while [[ $# -gt 0 ]]; do
        invoked_var_name="${1%%=*}"
        invoked_var_value="${1#*=}"
        export "$invoked_var_name=$invoked_var_value"
        shift
    done
fi

# The commands root paths
export X_PULSE_DIR="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" &> /dev/null && pwd)"
export X_CORE_DIR=$(readlink -f "${X_PULSE_DIR}/../libexec/${invoked_program}")
export X_ACTIONABLE_DIR="${X_CORE_DIR}/command/$invoked_service/$invoked_command"

source ${X_CORE_DIR}/module/variables.sh
source ${X_CORE_DIR}/module/functions.sh

invoked_action='action@run.sh'
if [ ! -x "$X_ACTIONABLE_DIR/$invoked_action" ]; then
    x::log_error "Fatal: command not implemented '$invoked_service $invoked_command'"
    exit 1
fi

export X_ACTIONABLE_SERVICE="$invoked_service"
export X_ACTIONABLE_COMMAND="$invoked_command"

command_log_dir="/var/log/${invoked_program}/command"
if [ ! -d "$command_log_dir" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        command_log_dir="/tmp/${invoked_program}/command"
    fi
    mkdir --parents $command_log_dir
    chmod ugo+rwx $command_log_dir
fi

command_log_file="${command_log_dir}/${invoked_service}-${invoked_command}.log"

x::execute_activations $invoked_action 2>&1 | tee $command_log_file
